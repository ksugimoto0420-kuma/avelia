# ---------------------------------------------------------------------------
# Database (Docker Compose default)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://avelia:avelia_password@localhost:5432/avelia_funclub?schema=public"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
#   生成例: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="please-change-this-to-a-random-32+-char-secret"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# アプリのベースURL（Webhook成功/キャンセルURL等に使用）
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Stripe（決済）
#   ダッシュボード > 開発者 > APIキー / Webhook から取得
#   ローカルWebhookは `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER="stripe"
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_CURRENCY="jpy"

# PAY.JP（将来拡張用・任意）
PAYJP_SECRET_KEY=""
PAYJP_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# ストレージ（S3互換 / デジタルコンテンツ・画像）
#   MVPではローカル ./public/uploads にフォールバック
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# メール（Resend 等）— 未設定時はコンソール出力にフォールバック
# ---------------------------------------------------------------------------
MAIL_DRIVER="console"
RESEND_API_KEY=""
MAIL_FROM="Avelia FunClub <no-reply@example.com>"

# ---------------------------------------------------------------------------
# 在庫仮確保の有効期限（分）
# ---------------------------------------------------------------------------
RESERVATION_TTL_MINUTES="15"

# Vercel Cron 等から叩く保護用トークン
CRON_SECRET="please-change-this-cron-secret"
