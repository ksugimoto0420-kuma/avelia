# ---------------------------------------------------------------------------
# Database (Docker Compose default for local; Vercel + Neon for production)
# Prisma reads POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING (Neon naming).
# Vercel + Neon integration auto-injects these. For local, copy the same value.
# DATABASE_URL is kept for compatibility with non-Prisma tools (docker, scripts).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://avelia:avelia_password@localhost:5432/avelia_funclub?schema=public"
POSTGRES_PRISMA_URL="postgresql://avelia:avelia_password@localhost:5432/avelia_funclub?schema=public"
POSTGRES_URL_NON_POOLING="postgresql://avelia:avelia_password@localhost:5432/avelia_funclub?schema=public"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
#   生成例: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="please-change-this-to-a-random-32+-char-secret"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# アプリのベースURL（Webhook成功/キャンセルURL等に使用）
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Stripe（決済）
#   ダッシュボード > 開発者 > APIキー / Webhook から取得
#   ローカルWebhookは `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER="stripe"
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_CURRENCY="jpy"

# PAY.JP（将来拡張用・任意）
PAYJP_SECRET_KEY=""
PAYJP_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# ストレージ（デジタルコンテンツ・画像）
#   local       : 開発ローカル。./storage 配下に保存
#   vercel-blob : Vercel Blob。BLOB_READ_WRITE_TOKEN を Vercel が自動注入
#                 （bucket 分割・複数トークンは #15 PR-3/PR-4 で導入予定）
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
# Vercel Blob を Preview / Production で使う場合、
# Vercel の Blob ストア連携で BLOB_READ_WRITE_TOKEN が自動注入される。
# ローカルで実 Blob に接続したい場合のみ手動設定:
# BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# メール（Resend 等）— 未設定時はコンソール出力にフォールバック
# ---------------------------------------------------------------------------
MAIL_DRIVER="console"
RESEND_API_KEY=""
MAIL_FROM="Avelia FunClub <no-reply@example.com>"

# ---------------------------------------------------------------------------
# 在庫仮確保の有効期限（分）
# ---------------------------------------------------------------------------
RESERVATION_TTL_MINUTES="15"

# Vercel Cron 等から叩く保護用トークン
CRON_SECRET="please-change-this-cron-secret"
